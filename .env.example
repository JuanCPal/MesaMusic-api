# Copia este archivo como .env y completa tus valores reales.
# El .env NUNCA debe subirse a git (agrégalo a .gitignore).

PORT=

# Tu API key de Google Cloud con YouTube Data API v3 habilitada
YOUTUBE_API_KEY=

# IDs de video de YouTube separados por coma, para reproducir en bucle
# cuando la cola esté vacía. Ejemplo con IDs reales de música libre de copyright:
BACKUP_PLAYLIST=

# En desarrollo puedes dejar "*". En producción, pon el dominio real de tu frontend.
ALLOWED_ORIGINS=*

# URL base del frontend para construir links de ingreso y codificarlos en QR.
# Ejemplo local con Next.js:
FRONTEND_BASE_URL=http://localhost:3000

# --- Base de datos (opcional). Si DATABASE_URL está vacía, la app corre en modo memoria. ---
# Runtime: pooler de Supabase en modo transacción (puerto 6543).
DATABASE_URL=
# Solo migraciones: pooler de Supabase en modo sesión (puerto 5432).
DATABASE_MIGRATE_URL=
# true = aplica las migraciones pendientes al arrancar.
DB_AUTO_MIGRATE=false
# Tamaño máximo del pool (1-10, por defecto 5).
DB_MAX_CONNS=5
